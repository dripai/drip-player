{
  "name": "shadow-player",
  "private": true,
  "version": "1.0.5",
  "description": "A Tauri desktop media player with probe-first local and online playback.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:dripai/drip-player.git"
  },
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "icons": "node scripts/generate-icons.mjs",
