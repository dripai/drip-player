{
  "productName": "ShadowPlayer",
  "version": "1.0.8",
  "identifier": "com.shadow.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "pnpm build:tauri",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Shadow Player",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "macOS": { "entitlements": "Entitlements.plist" },
    "windows": {
      "wix": {
        "upgradeCode": "51c3c796-888a-5e52-aecd-76eed5f91340"
      }
    },
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "../lib": "lib"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0N0ZEREExRjQzMzAxMDIKUldRQ0FUUDBvZDEveEdYc3FXSTk0MWdRdlJnNHhlS2x4a0YyQk10cXVROGdVYlJQLzdvZitLblUK",
      "endpoints": [
        "https://github.com/dripai/drip-player/releases/latest/download/latest.json"
      ]
    }
  }
}
